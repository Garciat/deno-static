{
  "imports": {
    "deno-static/": "./"
  },
  "tasks": {
    "build": "deno run --allow-all example/main.tsx",
    "serve": "deno run --allow-all --watch=./example/ example/main.tsx --dev"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "npm:react@^19",
    "strict": true
  },
  "lint": {
    "rules": {
      "exclude": ["no-import-prefix"]
    }
  }
}
